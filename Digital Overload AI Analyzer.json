    {
      "parameters": {
        "jsCode": "const rawResponse = $json.text;\n\nconst cleanedResponse = rawResponse\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nconst parsedData = JSON.parse(cleanedResponse);\n\nreturn [\n{\njson: {\noverloadScore: parsedData.overload_score,\nburnoutRisk: parsedData.burnout_risk,\nmainProblem: parsedData.main_problem,\npriorityTasks: parsedData.priority_tasks.join(\", \"),\ncanDelay: parsedData.can_delay.join(\", \"),\nsuggestedSchedule: parsedData.suggested_schedule,\nfocusTip: parsedData.focus_tip,\nconfidenceScore: parsedData.confidence_score\n}\n}\n];"
